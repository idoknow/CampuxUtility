PORT=8999

# 图片生命时间（小时），默认24小时
# 超过这个时间的图片文件将被自动清理
IMAGE_LIFETIME_HOURS=24

# 图片存储后端：local（默认）或 s3（兼容 Cloudflare R2）
STORAGE_BACKEND=local

# STORAGE_BACKEND=s3 时必填
# S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_BUCKET=astrbot-t2i
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# S3_PREFIX=images
